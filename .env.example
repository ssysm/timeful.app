# =============================================================================
# Timeful App - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Required fields are marked with (required)
# =============================================================================

# -----------------------------------------------------------------------------
# Host Configuration
# -----------------------------------------------------------------------------
HOST_PORT=80                    # Port to expose the app on your host
HOST_SSL_PORT=443               # Port for HTTPS (if configured)

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VUE_APP_POSTHOG_API_KEY=        # PostHog analytics API key (optional)

# -----------------------------------------------------------------------------
# Google OAuth (required)
# -----------------------------------------------------------------------------
# Create a Google Cloud project and OAuth 2.0 credentials
# Required scopes:
#   - ./auth/calendar.events.readonly
#   - ./auth/calendar.calendarlist.readonly
#   - ./auth/contacts.readonly
#   - ./auth/directory.readonly
CLIENT_ID=                      # (required) Google OAuth Client ID
CLIENT_SECRET=                  # (required) Google OAuth Client Secret
ANDROID_CLIENT_ID=              # Android OAuth Client ID (optional)
IOS_CLIENT_ID=                  # iOS OAuth Client ID (optional)

# -----------------------------------------------------------------------------
# Google Cloud Services (optional)
# -----------------------------------------------------------------------------
# Create a service account with Cloud Tasks permissions
SERVICE_ACCOUNT_KEY_PATH=       # Path to service account JSON key file

# -----------------------------------------------------------------------------
# Slack Integration (optional)
# -----------------------------------------------------------------------------
SLACK_DEV_WEBHOOK_URL=          # Slack webhook for dev notifications
SLACK_PROD_WEBHOOK_URL=         # Slack webhook for prod notifications

# -----------------------------------------------------------------------------
# Listmonk Email Service (optional)
# -----------------------------------------------------------------------------
LISTMONK_URL=                   # Listmonk instance URL
LISTMONK_USERNAME=              # Listmonk admin username
LISTMONK_PASSWORD=              # Listmonk admin password
LISTMONK_LIST_ID=               # Default mailing list ID
LISTMONK_INITIAL_EMAIL_REMINDER_ID=    # Template ID for initial reminder
LISTMONK_SECOND_EMAIL_REMINDER_ID=     # Template ID for second reminder
LISTMONK_FINAL_EMAIL_REMINDER_ID=      # Template ID for final reminder

# -----------------------------------------------------------------------------
# Gmail SMTP (optional)
# -----------------------------------------------------------------------------
# Use an app-specific password, not your main Gmail password
GMAIL_APP_PASSWORD=             # Gmail app password for SMTP
SCHEJ_EMAIL_ADDRESS=            # Email address to send from

# -----------------------------------------------------------------------------
# Security (required)
# -----------------------------------------------------------------------------
# ENCRYPTION_KEY: Used to encrypt sensitive data in the database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=                 # (required) 32-byte hex encryption key

# SESSION_SECRET: Used for session cookie encryption
# Must be at least 32 characters
# Generate with: openssl rand -base64 32
SESSION_SECRET=                 # (required) Session secret (min 32 chars)
